// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Simulation {
  id                 String   @id @default(uuid())
  clientDocument     String
  principalAmount    Decimal  @db.Decimal(12, 2)
  amortizationType   String   // 'SAC' ou 'PRICE'
  createdAt          DateTime @default(now())

  installments       Installment[] // Relacionamento 1:N

  @@map("simulations") // Nome da tabela no banco
}

model Installment {
  id               String   @id @default(uuid())
  simulationId     String
  period           Int
  installmentValue Decimal  @db.Decimal(12, 2)
  amortization     Decimal  @db.Decimal(12, 2)
  interest         Decimal  @db.Decimal(12, 2)
  balance          Decimal  @db.Decimal(12, 2)

  simulation       Simulation @relation(fields: [simulationId], references: [id])

  @@map("installments")
}